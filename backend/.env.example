NODE_ENV=development

APP_NAME=ai-code-review-platform
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=5000

MONGODB_URI=
MONGODB_DB_NAME=code-review
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

USER_TIER=free

FREE_MAX_LINES=500
FREE_MAX_FILES=1
FREE_MAX_CONCURRENT_REVIEWS=1

PRO_MAX_LINES=5000
PRO_MAX_FILES=100
PRO_MAX_CONCURRENT_REVIEWS=3

ENTERPRISE_MAX_LINES=1000000
ENTERPRISE_MAX_FILES=1000
ENTERPRISE_MAX_CONCURRENT_REVIEWS=10

REQUEST_BODY_LIMIT=1mb
UPLOAD_LIMIT_BYTES=10485760
CORS_ORIGINS=
TRUST_PROXY=false

MAX_AST_NODES=100000
MAX_TRAVERSAL_DEPTH=1000

AI_ENABLED=false
AI_PROVIDER=groq
AI_TIMEOUT_MS=30000
AI_MAX_FINDINGS=25
AI_MAX_SOURCE_BYTES=50000
AI_MAX_CONTEXT_BYTES=200000
AI_TEMPERATURE=0
AI_MAX_OUTPUT_TOKENS=3000

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_TOKEN=
GITHUB_TIMEOUT_MS=30000
GITHUB_MAX_FILES=1000
GITHUB_MAX_FILE_BYTES=5242880
GITHUB_MAX_TOTAL_BYTES=52428800
GITHUB_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=code-review/reports
CLOUDINARY_SECURE=true

REDIS_URL=redis://127.0.0.1:6379

QUEUE_CONCURRENCY=3
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000

REVIEW_QUEUE_NAME=review
REPORT_QUEUE_NAME=report
CLEANUP_QUEUE_NAME=cleanup
NOTIFICATION_QUEUE_NAME=notification

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000