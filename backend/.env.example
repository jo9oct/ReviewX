NODE_ENV=development

APP_NAME=ReviewX
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=5000

# Authentication & Security
# In production, JWT_SECRET must be a strong random secret (e.g. 64 hex characters)
JWT_SECRET=dev-jwt-secret-reviewx-change-in-production
JWT_EXPIRES_IN=7d

# Database (MongoDB connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/reviewx
MONGODB_DB_NAME=code-review
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_AUTO_INDEX=true

# Access Tiers & Limits
USER_TIER=free
FREE_MAX_LINES=500
FREE_MAX_FILES=1
FREE_MAX_CONCURRENT_REVIEWS=1

PRO_MAX_LINES=5000
PRO_MAX_FILES=100
PRO_MAX_CONCURRENT_REVIEWS=3

ENTERPRISE_MAX_LINES=1000000
ENTERPRISE_MAX_FILES=1000
ENTERPRISE_MAX_CONCURRENT_REVIEWS=10

REQUEST_BODY_LIMIT=1mb
UPLOAD_LIMIT_BYTES=10485760
# Comma-separated list of allowed frontend origins (e.g. https://reviewx.dev,http://localhost:3000)
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

MAX_AST_NODES=100000
MAX_TRAVERSAL_DEPTH=1000

# AI Review Engine
AI_ENABLED=true
AI_PROVIDER=groq
AI_TIMEOUT_MS=30000
AI_MAX_FINDINGS=25
AI_MAX_SOURCE_BYTES=50000
AI_MAX_CONTEXT_BYTES=200000
AI_TEMPERATURE=0
AI_MAX_OUTPUT_TOKENS=3000

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GitHub OAuth & Integration
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5000/api/v1/github/callback
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITHUB_TIMEOUT_MS=30000
GITHUB_MAX_FILES=1000
GITHUB_MAX_FILE_BYTES=5242880
GITHUB_MAX_TOTAL_BYTES=52428800

# Cloudinary Storage (for report storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=ReviewX/reports
CLOUDINARY_SECURE=true

# Redis & Queue Processing
REDIS_URL=redis://127.0.0.1:6379
REVIEW_SOURCE_REDIS_PREFIX=review:source
REVIEW_SOURCE_TTL_SECONDS=3600

QUEUE_CONCURRENCY=3
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000
QUEUE_REMOVE_ON_COMPLETE=100
QUEUE_REMOVE_ON_FAIL=100

REVIEW_QUEUE_NAME=review
REPORT_QUEUE_NAME=report
CLEANUP_QUEUE_NAME=cleanup
NOTIFICATION_QUEUE_NAME=notification

SCHEDULER_ENABLED=true
SCHEDULER_MIN_INTERVAL_SECONDS=60

# Chapa Payment Integration
# Use CHASECK_TEST- for staging/testing, CHASECK_LIVE- for production
CHAPA_SECRET_KEY=your_chapa_secret_key_here
PAYMENT_CURRENCY=ETB
PRO_PLAN_PRICE=500
ENTERPRISE_PLAN_PRICE=5000

# Application URLs
# In production, BACKEND_URL is your server URL (used for payment callbacks)
# FRONTEND_URL is your web app URL (used for invite emails and payment return)
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Email Delivery (Resend API)
# Used for invitation links and notifications.
# Leave RESEND_API_KEY empty in local dev to log emails to console.
# In production, use a verified domain (e.g. "ReviewX <noreply@yourdomain.com>")
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="ReviewX <onboarding@resend.dev>"

# Platform Admin Seed (npm run seed:admin)
PLATFORM_ADMIN_NAME=Admin
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change_this_strong_password_in_prod